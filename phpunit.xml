<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory="tests/.phpunit.cache"
>
    <testsuites>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Stage2-Stage5A">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <group>geo11-scale</group>
            <group>geo11-real-db</group>
            <group>geo12-real-db</group>
            <group>geo13-real-db</group>
            <group>geo14-real-db</group>
            <group>geo15-real-db</group>
            <group>geo-live-real-db</group>
            <group>cor004-real-db</group>
            <group>cor006-real-db</group>
            <group>cor007-real-db</group>
            <group>cor005-real-db</group>
            <group>operation-store-real-db</group>
            <group>rule-lifecycle-real-db</group>
            <group>data-lifecycle-real-db</group>
            <group>emergency-control-real-db</group>
            <group>quote-storage-real-db</group>
            <group>quote-lifecycle-real-db</group>
        </exclude>
    </groups>
</phpunit>
